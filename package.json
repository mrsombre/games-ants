{
  "name": "games-ants",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "bundle": "pnpm build && pnpm type-check && pnpm check:ci && pnpm test",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "pnpm --filter frontend preview",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "test": "pnpm --reporter=append-only run -r --parallel --if-present --no-bail test",
    "type-check": "pnpm types && pnpm --reporter=append-only run -r --parallel --if-present --no-bail type-check",
    "types": "wrangler types --strict-vars=false",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
