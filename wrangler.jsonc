{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games-ants",
  "main": "apps/backend/src/index.ts",
  "compatibility_date": "2026-07-08",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
