{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "apps/frontend/vitest.config.ts",
    "dir": "apps/frontend"
  },
  "mutate": [
    "apps/frontend/src/game/*.ts",
    "!apps/frontend/src/game/*.test.ts",
    "!apps/frontend/src/game/test-support.ts",
    "!apps/frontend/src/game/scene.ts"
  ],
  "ignorePatterns": [".tmp/**"],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 5000,
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": {
    "fileName": ".tmp/mutation/report.json"
  },
  "htmlReporter": {
    "fileName": ".tmp/mutation/report.html"
  },
  "tempDirName": ".tmp/stryker",
  "cleanTempDir": false,
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 95
  },
  "plugins": ["@stryker-mutator/vitest-runner"]
}
